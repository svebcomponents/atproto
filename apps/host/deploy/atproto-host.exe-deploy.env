# Copy to exe-deploy/apps/atproto-host.env on the VM (see
# https://github.com/Theo-Steiner/exe-deploy). Kept here too so the deploy
# config for this app isn't tribal knowledge living only on the VM.

APP_NAME=atproto-host

# This app lives inside the atproto monorepo, not its own repo.
REPO_URL=https://github.com/svebcomponents/atproto.git
BRANCH=main

APP_ROOT=/home/exedev/apps/atproto-host

# --- Build ---
NODE_VERSION=24
PNPM_VERSION=10
INSTALL_CMD="pnpm install --frozen-lockfile"
# Only builds atproto-host + its workspace deps (atproto.bridge,
# atproto.client, atproto.comments), not the whole monorepo.
BUILD_CMD="pnpm --filter atproto-host... build"
# adapter-node's output lives under apps/host, not the worktree root.
START_CMD="node apps/host/build/index.js"

# --- Persistent state (survives deploys) ---
# The SQLite file must not live under a relative path — see
# runtime.env.example for why. deploy.sh creates this dir under APP_ROOT,
# outside releases/, before every build.
PERSIST_DIRS="data"

# --- Runtime (the app service) ---
APP_PORT=3000
ADDRESS_HEADER=X-Forwarded-For
XFF_DEPTH=1
PROTOCOL_HEADER=X-Forwarded-Proto
HOST_HEADER=X-Forwarded-Host

# --- Deploy listener ---
DEPLOY_PORT=8899
OWNER_EMAIL=theosteiner@googlemail.com
