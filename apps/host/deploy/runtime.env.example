# Copy to $APP_ROOT/runtime.env on the VM (e.g.
# /home/exedev/apps/atproto-host/runtime.env), chmod 600, NOT in git.
# app.service.tmpl loads this via `EnvironmentFile=-$APP_ROOT/runtime.env`.
#
# IMPORTANT: every path here must live outside $APP_ROOT/releases and
# $APP_ROOT/current. exe-deploy builds each release into a fresh git
# worktree and flips a symlink between them — anything written under
# `current` (including a relative ./.data/service.db) is a *new*, empty
# path on every single deploy, silently wiping all OAuth sessions each
# time. SERVICE_DB_PATH below points at $APP_ROOT/data instead, which
# atproto-host.exe-deploy.env's PERSIST_DIRS="data" creates outside
# releases/ before every build, and which app.service.tmpl's
# `ReadWritePaths=$APP_ROOT` sandbox rule keeps writable.

SERVICE_URL=https://atproto.svebcomponents.dev
# Generate these two with: apps/host/deploy/generate-secrets.sh
SESSION_SECRET=replace-with-a-long-random-secret
OAUTH_PRIVATE_KEYS=
SERVICE_DB_PATH=/home/exedev/apps/atproto-host/data/service.db
SESSION_MODE=bearer

SPACEDUST_URL=wss://spacedust.microcosm.blue
COMMENT_STREAM_MAX_THREADS=5000
COMMENT_STREAM_MAX_SUBSCRIBERS=10000
COMMENT_STREAM_MAX_SUBSCRIBERS_PER_THREAD=1000
COMMENT_STREAM_HEARTBEAT_MS=15000
