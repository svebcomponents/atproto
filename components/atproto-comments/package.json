{
  "name": "@svebcomponents/atproto.comments",
  "version": "0.7.0",
  "type": "module",
  "jsdelivr": "./dist/client/index.js",
  "description": "Web component rendering ATProto/Bluesky threads as blog comments",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svebcomponents/atproto.git",
    "directory": "components/atproto-comments"
  },
  "homepage": "https://github.com/svebcomponents/atproto#readme",
  "bugs": "https://github.com/svebcomponents/atproto/issues",
  "keywords": [
    "atproto",
    "bluesky",
    "comments",
    "custom-element",
    "web-component",
    "svelte"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "exports": {
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./svelte": {
      "types": "./dist/client/index.svelte-types.d.ts"
    },
    "./ssr": {
      "types": "./dist/server/ssr.d.ts",
      "default": "./dist/server/ssr.js"
    }
  },
  "customElements": "custom-elements.json",
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "svebcomponents",
    "lint": "pnpm /^lint:.*/",
    "lint:eslint": "eslint .",
    "lint:format": "prettier --check .",
    "fix": "pnpm /^fix:.*/",
    "fix:eslint": "eslint . --fix",
    "fix:format": "prettier --write .",
    "check": "svelte-check",
    "test": "vitest run",
    "test:dev": "vitest --watch"
  },
  "devDependencies": {
    "@svebcomponents/build": "catalog:",
    "@svebcomponents/eslint-config": "workspace:*",
    "@svebcomponents/prettier-config": "workspace:*",
    "@svebcomponents/ssr": "catalog:",
    "@svebcomponents/typescript-config": "workspace:*",
    "esm-env": "^1.2.0",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@svebcomponents/atproto.client": "workspace:*"
  },
  "peerDependencies": {
    "@svebcomponents/ssr": "^0.8.0"
  },
  "peerDependenciesMeta": {
    "@svebcomponents/ssr": {
      "optional": true
    }
  }
}
