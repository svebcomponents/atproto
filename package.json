{
  "name": "atproto-comments-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "changeset": "changeset",
    "dev": "turbo watch dev",
    "check": "turbo check",
    "lint": "turbo lint",
    "lint:packages": "publint packages/atproto-client && publint packages/service-core && publint components/atproto-comments",
    "fix": "turbo fix",
    "test": "turbo test",
    "test:dev": "turbo test:dev",
    "release": "turbo build && pnpm lint:packages && changeset publish",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "publint": "catalog:",
    "turbo": "catalog:"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^22.19.0 || >=24.11.0"
  }
}
